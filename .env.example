# Webhook URLs (public)
NEXT_PUBLIC_N8N_GENERATE_IMAGE_WEBHOOK_URL=https://example.com/generate-image-webhook
NEXT_PUBLIC_N8N_PUBLISH_POST_WEBHOOK_URL=https://example.com/publish-post-webhook

# Secret for N8N webhooks (server-only)
N8N_WEBHOOK_SECRET=supersecret1234

# Supabase config (public)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=public-anon-key-1234567890

CRON_SECRET=key-for-cron-jobs-1234567890
SUPABASE_SERVICE_ROLE_KEY=service-role-key-1234567890
OPENAI_API_KEY=your-openai-api-key-1234567890
SMTP_HOST=your-smtp-host
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=your-smtp-from
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true